#!/bin/bash
# cedric: open files in Owlink from the command line (the running app if
# there is one). Install with:
#
#   ln -s "/Applications/Owlink.app/Contents/Resources/cedric" /usr/local/bin/cedric
#
#   cedric file ...         open files (missing files open as new, empty tabs)
#   cedric file:42          open at line 42 (also +42 before the file)
#   cedric file:42:7        open at line 42, column 7
#   cedric -w file ...      wait until each file's tab is closed (for
#                           git and other tools: EDITOR="cedric -w")
#   cedric dir              open a folder in the folder sidebar (with -w:
#                           returns at once, a folder has no tab to wait for)
#   cedric -                read stdin into a new untitled tab
#   cedric                  bring Owlink forward
#
# CEDRIC_DRY_RUN=1 prints the cedric:// URLs instead of opening them (tests).
set -euo pipefail

# The app this script lives in ("Owlink.app"), else CEDRIC_APP (a name or
# path), else whichever copy Launch Services knows by the bundle id.
here=$(cd "$(dirname "$(readlink "$0" 2>/dev/null || echo "$0")")" && pwd)
case "$here" in
    *.app/Contents/Resources) TARGET=(-a "${here%/Contents/Resources}") ;;
    *) if [ -n "${CEDRIC_APP:-}" ]; then TARGET=(-a "$CEDRIC_APP"); else TARGET=(-b net.mindtricks.cedric); fi ;;
esac
DRY=${CEDRIC_DRY_RUN:-}

# The user's own temp folder, as the app sees it (NSTemporaryDirectory):
# the app accepts hand-off files only there. Asked of the system, not read
# from TMPDIR, which may point elsewhere (Nix shells, tmux) or be unset
# (ssh, cron).
tmpdir=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || true)
[ -n "$tmpdir" ] || tmpdir=${TMPDIR:-/tmp}
tmpdir=${tmpdir%/}

# The secret that tells the app a URL is from this script, not a web page:
# a random token in a file only this user can read. Made here if the app
# hasn't made it yet: written to a private temp file in the same folder,
# then hard-linked into place, so nobody ever reads a half-written token and
# a token already there (the app's, another run's) is never replaced,
# except an empty one older than about 5 s. An empty read (an older app
# writing straight into the file) gets one retry 50 ms later. The folder is
# owner-only (0700).
token_file="$HOME/Library/Application Support/Cedric/cli-token"
# The token's temp file, removed however the script exits (and the -w markers).
token_tmp=""
cleanup() {
    [ -z "$token_tmp" ] || rm -f "$token_tmp"
    [ -z "${markers+x}" ] || [ ${#markers[@]} -eq 0 ] || rm -f "${markers[@]}"
}
trap cleanup EXIT
token() {
    local dir t ino=""
    # Run as $(token), a subshell: its own exit removes the temp file.
    if [ "${BASH_SUBSHELL:-0}" -gt 0 ]; then trap '[ -z "$token_tmp" ] || rm -f "$token_tmp"' EXIT; fi
    dir=$(dirname "$token_file")
    if [ ! -s "$token_file" ]; then
        mkdir -p -m 700 "$dir"
        # Made wider by an older Cedric: tighten it (only our own real folder).
        if [ -d "$dir" ] && [ ! -L "$dir" ] && [ -O "$dir" ] && [ "$(stat -f %Lp "$dir")" != 700 ]; then
            chmod 700 "$dir" 2>/dev/null || true
        fi
        # An empty token older than about 5 s was left by a run that died
        # before filling it: it is replaced below.
        if [ -f "$token_file" ] && [ ! -L "$token_file" ] && [ -O "$token_file" ] && [ ! -s "$token_file" ] &&
            [ $(( $(date +%s) - $(stat -f %m "$token_file") )) -gt 5 ]; then
            ino=$(stat -f %i "$token_file")
        fi
        if token_tmp=$(umask 077; mktemp "$dir/.cli-token.XXXXXX" 2>/dev/null); then
            if { head -c 16 /dev/urandom | xxd -p | tr -d '\n'; echo; } > "$token_tmp" 2>/dev/null; then
                # ln never replaces: the stale empty file goes first, only
                # if it is still empty and still the same file.
                if [ -n "$ino" ] && [ ! -s "$token_file" ] && [ "$(stat -f %i "$token_file" 2>/dev/null)" = "$ino" ]; then
                    rm -f "$token_file"
                fi
                ln "$token_tmp" "$token_file" 2>/dev/null || true
            fi
            rm -f "$token_tmp"
            token_tmp=""
        else
            token_tmp=""
        fi
    fi
    t=$(tr -d '\n' < "$token_file" 2>/dev/null || true)
    if [ -z "$t" ]; then
        sleep 0.05
        t=$(tr -d '\n' < "$token_file" 2>/dev/null || true)
    fi
    printf '%s' "$t"
}
TOKEN=""

urlencode() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe="/"))' "$1"; }
# Every URL carries the token, in a hand-off file the app reads once and
# deletes: auth=<file>. Not on open's command line, where other users on
# this Mac could read it with ps. The file is 0600 in the user's own temp
# folder (shown as AUTH in a dry run). The app makes a new token at every
# launch.
send() {
    if [ -n "$DRY" ]; then echo "$1&auth=AUTH"; return; fi
    [ -n "$TOKEN" ] || TOKEN=$(token)
    local auth
    auth=$(umask 077; mktemp "$tmpdir/cedric-auth.XXXXXX")
    printf '%s\n' "$TOKEN" > "$auth"
    open "${TARGET[@]}" "$1&auth=$(urlencode "$auth")"
}

if [ $# -eq 0 ]; then
    [ -n "$DRY" ] && exit 0
    exec open "${TARGET[@]}"
fi

wait=""
args=()
for arg in "$@"; do
    case "$arg" in
        -w|--wait) wait=1 ;;
        -h|--help) sed -n '2,17p' "$0"; exit 0 ;;
        *) args+=("$arg") ;;
    esac
done

# Make sure the app is running (and has registered its URL scheme) first.
[ -n "$DRY" ] || open -g "${TARGET[@]}"

# With -w: one marker file per file; the app deletes it when that tab closes.
markers=()
line=""
for arg in ${args[@]+"${args[@]}"}; do
    case "$arg" in
        +[0-9]*) line=${arg#+}; continue ;;
        -)
            tmp=$(mktemp "$tmpdir/cedric-stdin.XXXXXX")
            cat > "$tmp"
            send "cedric://open?untitled=$(urlencode "$tmp")"
            continue ;;
    esac
    path=$arg
    col=""
    if [ ! -e "$arg" ]; then
        if [[ "$arg" =~ ^(.+):([0-9]+):([0-9]+):?$ ]]; then
            path=${BASH_REMATCH[1]}; line=${BASH_REMATCH[2]}; col=${BASH_REMATCH[3]}
        elif [[ "$arg" =~ ^(.+):([0-9]+):?$ ]]; then
            path=${BASH_REMATCH[1]}; line=${BASH_REMATCH[2]}
        fi
    fi
    case "$path" in /*) ;; *) path="$PWD/$path" ;; esac
    url="cedric://open?path=$(urlencode "$path")"
    [ -n "$line" ] && url="$url&line=$line"
    [ -n "$col" ] && url="$url&col=$col"
    if [ -n "$wait" ]; then
        marker=$(mktemp "$tmpdir/cedric-wait.XXXXXX")
        markers+=("$marker")
        url="$url&wait=$(urlencode "$marker")"
    fi
    send "$url"
    line=""
done

[ -n "$DRY" ] && [ ${#markers[@]} -gt 0 ] && rm -f "${markers[@]}"

# Wait for every marker to go (or for the app to quit; its executable is
# still named Cedric).
if [ -n "$wait" ] && [ -z "$DRY" ] && [ ${#markers[@]} -gt 0 ]; then
    while :; do
        left=0
        for m in "${markers[@]}"; do [ -e "$m" ] && left=1; done
        [ $left -eq 0 ] && break
        pgrep -x Cedric >/dev/null || break
        sleep 0.2
    done
fi
